/**
 * ドキュメントサイトと素材 (docs/out) を Cloudflare Workers の static assets として配信する。
 * assets-only Worker (main なし・binding なし)。https://assets.morinoparty.workers.dev/
 * デプロイ: pnpm build && pnpm deploy (CI: .github/workflows/deploy.yml)
 */
{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "assets",
    "compatibility_date": "2026-11-01",
    "assets": {
        "directory": "./out",
        // プリレンダーした複数の HTML で構成するため、SPA フォールバックではなく 404.html を返す
        "not_found_handling": "404-page",
    },
    "workers_dev": true,
    "preview_urls": true,
    "observability": {
        "enabled": false,
    },
}
